{
    "name": "nikba/sms.md-php-api",
    "description": "Modern PHP SDK for the sms.md v3 API — send SMS, bulk, OTP, cost estimate, delivery status, contacts and balance.",
    "keywords": ["sms.md", "sms", "otp", "php", "api", "sdk", "moldova", "psr-18"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bargan Nicolai",
            "email": "office@nikba.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Nikba\\SmsMdPhpApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nikba\\SmsMdPhpApi\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.5",
        "phpunit/phpunit": "^10.5",
        "php-http/mock-client": "^1.6",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 HTTP client; auto-discovered when installed."
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
